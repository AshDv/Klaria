{
  "$schema": "https://developer.microsoft.com/en-us/json-schemas/teams/v1.19/MicrosoftTeams.schema.json",
  "manifestVersion": "1.19",
  "version": "1.0.0",
  "id": "{{MICROSOFT_APP_ID}}",
  "developer": {
    "name": "Nolya",
    "websiteUrl": "https://{{PUBLIC_DOMAIN}}",
    "privacyUrl": "https://{{PUBLIC_DOMAIN}}/privacy-policy",
    "termsOfUseUrl": "https://{{PUBLIC_DOMAIN}}/terms"
  },
  "name": { "short": "Nolya", "full": "Nolya, intelligence de réunion" },
  "description": {
    "short": "Transcriptions, décisions et actions dans Teams.",
    "full": "Nolya transforme une réunion consentie en transcription, décisions, actions et brief audio."
  },
  "icons": { "outline": "outline.png", "color": "color.png" },
  "accentColor": "#173E35",
  "staticTabs": [
    {
      "entityId": "nolya-home",
      "name": "Accueil",
      "contentUrl": "https://{{PUBLIC_DOMAIN}}/?host=teams&view=dashboard",
      "websiteUrl": "https://{{PUBLIC_DOMAIN}}/",
      "scopes": ["personal"]
    },
    {
      "entityId": "nolya-meetings",
      "name": "Réunions",
      "contentUrl": "https://{{PUBLIC_DOMAIN}}/?host=teams&view=meetings",
      "websiteUrl": "https://{{PUBLIC_DOMAIN}}/",
      "scopes": ["personal"]
    },
    {
      "entityId": "nolya-actions",
      "name": "Actions",
      "contentUrl": "https://{{PUBLIC_DOMAIN}}/?host=teams&view=actions",
      "websiteUrl": "https://{{PUBLIC_DOMAIN}}/",
      "scopes": ["personal"]
    }
  ],
  "permissions": ["identity"],
  "validDomains": ["{{PUBLIC_DOMAIN}}"]
}
