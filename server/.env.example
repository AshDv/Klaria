# Application
ENVIRONMENT=development
SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=sqlite:///./klaria.db
CORS_ORIGINS=http://localhost:5174
FRONTEND_URL=http://localhost:5174
API_PUBLIC_URL=http://localhost:8000
UPLOAD_DIR=./data/recordings
MAX_AUDIO_MB=50
RESULT_RETENTION_DAYS=30
PRIVACY_VERSION=2026-08-21
DATA_CONTROLLER_NAME=Nom légal de votre organisation
DATA_CONTROLLER_ADDRESS=Adresse postale complète
PRIVACY_CONTACT_EMAIL=privacy@votre-domaine.fr

# Voxtral et Mistral utilisent la même clé API Mistral
MISTRAL_API_KEY=
MISTRAL_BASE_URL=https://api.eu.mistral.ai/v1
VOXTRAL_MODEL=voxtral-mini-latest
SUMMARY_MODEL=mistral-medium-3-5

# Bot Meet / Teams et transcription en direct
VEXA_API_URL=https://api.cloud.vexa.ai
VEXA_API_KEY=
VEXA_BOT_NAME=Klaria — prise de notes

# Google OAuth 2.0 / OpenID Connect (SSO)
# URI de redirection autorisée :
# http://localhost:8000/api/auth/sso/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_SCOPES="openid email profile https://www.googleapis.com/auth/calendar.events https://www.googleapis.com/auth/meetings.space.readonly"

# Microsoft Entra / Graph. Aucun abonnement Azure payant n'est requis.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
MICROSOFT_CALENDAR_SCOPES="openid profile email offline_access Calendars.ReadWrite"

# Générer deux valeurs aléatoires différentes pour la production.
TOKEN_ENCRYPTION_KEY=
AUTOMATION_KEY=
CALENDAR_SYNC_MINUTES=1
AUTOMATION_INTERVAL_SECONDS=15
BOT_JOIN_SECONDS_BEFORE=180
BOT_JOIN_GRACE_MINUTES=10

# Invitations de consentement
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
